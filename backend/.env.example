# PaperPilot Backend Environment Configuration

# Server Settings
PROJECT_NAME=PaperPilot
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Database
DATABASE_URL=sqlite:///./paperpilot.db

# Storage Paths
UPLOAD_DIR=./storage/uploads
CHROMA_PERSIST_DIR=./storage/chroma_db

# Authentication & Cookie Sessions
SESSION_COOKIE_NAME=paperpilot_session
SESSION_EXPIRE_HOURS=168
SESSION_COOKIE_SAMESITE=lax
# Set to true when deployed behind HTTPS
SESSION_COOKIE_SECURE=false
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_APP_URL=http://localhost:5173

# Optional SMTP Configuration for Forgot Password Email Delivery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM_EMAIL=noreply@paperpilot.example.com
# SMTP_USE_TLS=true

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
